    "build": "vite build",
    "preview": "vite preview",
    "lint": "echo 'No linting configured'"
  },
  "dependencies": {
    "electron": "^28.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "react-icons": "^5.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "wait-on": "^7.2.0",
    "vite": "^5.2.0"
  }
}
