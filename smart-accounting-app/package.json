{
  "name": "smart-accounting-app",
  "version": "0.1.0",
  "description": "Arabic smart accounting desktop application built with Electron and React.",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
